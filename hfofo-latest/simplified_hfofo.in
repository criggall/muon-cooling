### PHYSICS ###

physics QGSP_BIC doStochastics=0

### PARAMETERS ###

# Constants:
param m=105.7 #MeV
param c=2.997925*10^8 #m/s

# Reference particle:
param p=200 #MeV/c
param v=$p*$c/sqrt($p^2+$m^2)

# Solenoid current:
param sol_current=-80.46 #amps/mm^2

# Solenoid pitch:
param pitch=-0.1432394487827058 #deg

# Period length:
param period_len=4200 #mm

# Initial conditions:
param X=9.47954 #mm
param Y=16.0791 #mm
param Xp=0.064143 #radians
param Yp=-0.03725 #radians

param Xavg=9.91782273036963
param Yavg=15.596720602187812
param Xpavg=0.06689560651644771
param Ypavg=-0.03670911943095136
param Ptotavg=200.30423895641164
param Tavg=-0.006500556911088911

param Xavg2=9.523367982017984
param Yavg2=16.030861738261738
param Xpavg2=0.06441825310768562
param Ypavg2=-0.037195913963255924
param Ptotavg2=200.03042154038738
param Tavg2=-0.0006500556911088911

### BEAM ###

#beam gaussian particle=mu+ nEvents=100 \
#beamZ=500.0 beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp \ 
#sigmaX=10.0 sigmaY=10.0 sigmaXp=0.1 sigmaYp=0.1 \ 
#meanMomentum=$p sigmaP=10.0 meanT=0.0 sigmaT=0.0

#beam gaussian particle=mu+ nEvents=10 \
#beamZ=500.0 beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp \ 
#sigmaX=10.0 sigmaY=10.0 sigmaZ=100.0 sigmaXp=0.0 sigmaYp=0.0 \ 
#meanMomentum=$p sigmaP=0.0 meanT=0.0 sigmaT=0.0

# Testing:
#beam gaussian particle=mu+ nEvents=1000 \
#beamZ=500.0 beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp \ 
#sigmaX=10.0 sigmaY=10.0 sigmaZ=0.0 sigmaXp=0.1 sigmaYp=0.1 \ 
#meanMomentum=$p sigmaP=10.0 meanT=0.0 sigmaT=0.1
# --> zntuple_avg1.txt

#beam gaussian particle=mu+ nEvents=1 \
#beamZ=500.0 beamX=$Xavg beamY=$Yavg beamXp=$Xpavg beamYp=$Ypavg \ 
#sigmaX=0.0 sigmaY=0.0 sigmaZ=0.0 sigmaXp=0.0 sigmaYp=0.0 \ 
#meanMomentum=$Ptotavg sigmaP=0.0 meanT=$Tavg sigmaT=0.0
# --> zntuple_avg2.txt

#beam gaussian particle=mu+ nEvents=1000 \
#beamZ=500.0 beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp \ 
#sigmaX=1.0 sigmaY=1.0 sigmaZ=0.0 sigmaXp=0.01 sigmaYp=0.01 \ 
#meanMomentum=$p sigmaP=1.0 meanT=0.0 sigmaT=0.01
# --> zntuple_avg1_2.txt

#beam gaussian particle=mu+ nEvents=1 \
#beamZ=500.0 beamX=$Xavg2 beamY=$Yavg2 beamXp=$Xpavg2 beamYp=$Ypavg2 \ 
#sigmaX=0.0 sigmaY=0.0 sigmaZ=0.0 sigmaXp=0.0 sigmaYp=0.0 \ 
#meanMomentum=$Ptotavg2 sigmaP=0.0 meanT=$Tavg2 sigmaT=0.0
# --> zntuple_avg2.txt

# Finding transfer matrix:
beam gaussian particle=mu+ nEvents=1 \
beamZ=500.0 beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp \ 
sigmaX=0.0 sigmaY=0.0 sigmaXp=0.0 sigmaYp=0.0 \ 
meanMomentum=$p sigmaP=0.0 meanT=0.0-3.8e-4 sigmaT=0.0

### REFERENCE PARTICLE ###

# mu plus:
#reference referenceMomentum=$p particle=mu+ beamX=0.0 beamY=0.0 beamZ=500.0 beamXp=0.0 beamYp=0.0
reference referenceMomentum=$p particle=mu+ beamX=$X beamY=$Y beamZ=500.0 beamXp=$Xp beamYp=$Yp

# mu minus:
param tshift=-1/(325e6)*0.5
param zshift=$period_len*0.5
#reference referenceMomentum=$p particle=mu- beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp beamZ=500+$zshift

#trace nTrace=0 format=ascii oneNTuple=1
trace nTrace=10 format=ascii oneNTuple=1

### SOLENOIDS ###

coil coil innerRadius=420 outerRadius=600 length=300 nSheets=10 maxR=360 maxZ=6000 dR=15 dZ=15 tolerance=0.003 

solenoid SolPos coilName=coil current=-$sol_current color=0,1,1
solenoid SolNeg coilName=coil current=$sol_current color=0,1,0

### PLACEMENT ###

# 30 HFOFO periods + 1 at start + 1 at end for edge field effects

param num_periods=30

virtualdetector det file=det format=ascii radius=360 color=0,1,0 length=0.001 material=Vacuum

do i -1 $num_periods

    #virtualdetector det$i file=det$i format=ascii radius=360 color=0,1,0 length=0.001 material=Vacuum
    #place det$i z=500+$period_len*$i
    place det z=500+$period_len*$i
    if $i<$num_periods
        do j 1 11
            #place det$i z=500+$period_len*$i+$j*$period_len/12
            place det z=500+$period_len*$i+$j*$period_len/12
        enddo
    endif

    place SolPos z=500+$period_len*$i current=-$sol_current rotation=X$pitch,Z240
    place SolNeg z=1200+$period_len*$i current=$sol_current rotation=X$pitch
    place SolPos z=1900+$period_len*$i current=-$sol_current rotation=X$pitch,Z120
    place SolNeg z=2600+$period_len*$i current=$sol_current rotation=X$pitch,Z240
    place SolPos z=3300+$period_len*$i current=-$sol_current rotation=X$pitch
    place SolNeg z=4000+$period_len*$i current=$sol_current rotation=X$pitch,Z120

enddo

zntuple zloop=500:$period_len*30+500:10 format=ascii file=zntuple referenceParticle=1