###############
### PHYSICS ###
###############

physics QGSP_BIC doStochastics=0

##################
### PARAMETERS ###
##################

# Muon mass:
param m=105.7 #MeV

# Reference particle:
param p=200 #MeV/c

# Solenoid current:
param sol_current=-80.46 #amps/mm^2

# Solenoid pitch:
param pitch=-0.1432394487827058 #deg

# Period length:
param period_len=4200 #mm

# Cell spacing:
param space=$period_len/6 #mm

# Initial conditions:
param X=-11.2945 #mm
param Y=14.0917 #mm
param Xp=0.823201/224.995 #radians
param Yp=-1.27215/224.995 #radians

############
### BEAM ###
############

beam gaussian particle=mu+ nEvents=1 \
beamZ=0.0 beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp \ 
sigmaX=10.0 sigmaY=10.0 sigmaXp=0.1 sigmaYp=0.1 \ 
meanMomentum=$p sigmaP=10.0 meanT=0.0 sigmaT=0.0

##########################
### REFERENCE PARTICLE ###
##########################

# mu plus:
reference referenceMomentum=$p particle=mu+ beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp beamZ=0.0

# mu minus:
param tshift=-1/(325e6)*0.5
param zshift=$period_len*0.5
#reference referenceMomentum=$p particle=mu- beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp beamZ=$zshift

trace nTrace=0 format=ascii

#################
### SOLENOIDS ###
#################

coil coil innerRadius=420 outerRadius=600 length=300 nSheets=10 maxR=360 maxZ=6000 dR=15 dZ=15 tolerance=0.003 

solenoid SolPos coilName=coil current=-$sol_current color=0,1,1
solenoid SolNeg coilName=coil current=$sol_current color=0,1,0

#################
### PLACEMENT ###
#################

# 30 HFOFO periods + 1 at start + 1 at end for edge field effects

param num_periods=30

do i -1 $num_periods

    place SolPos z=500+$space*0+$period_len*$i current=-$sol_current rotation=X$pitch,Z240
    place SolNeg z=500+$space*1+$period_len*$i current=$sol_current rotation=X$pitch
    place SolPos z=500+$space*2+$period_len*$i current=-$sol_current rotation=X$pitch,Z120
    place SolNeg z=500+$space*3+$period_len*$i current=$sol_current rotation=X$pitch,Z240
    place SolPos z=500+$space*4+$period_len*$i current=-$sol_current rotation=X$pitch
    place SolNeg z=500+$space*5+$period_len*$i current=$sol_current rotation=X$pitch,Z120

enddo