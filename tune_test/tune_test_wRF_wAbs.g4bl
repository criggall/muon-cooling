###############
### PHYSICS ###
###############

physics QGSP_BIC doStochastics=0

##################
### PARAMETERS ###
##################

# Muon mass:
param m=105.7 #MeV

# Reference particle:
param p=200 #MeV/c

# Solenoid current:
param sol_current=-80.46 #amps/mm^2

# Solenoid pitch:
param pitch=-0.1432394487827058 #deg

# RF gradient:
param rf_grad=25 #MV/m

# Pillbox length:
param rf_len=250 #mm

# Period length:
param period_len=4200 #mm

# Cell spacing:
param space=$period_len/6 #mm

# Initial conditions:
param X=-11.2945 #mm
param Y=14.0917 #mm
param Xp=0.823201/224.995 #radians
param Yp=-1.27215/224.995 #radians

############
### BEAM ###
############

beam gaussian particle=mu+ nEvents=1 \
beamZ=0.0 beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp \ 
sigmaX=10.0 sigmaY=10.0 sigmaXp=0.1 sigmaYp=0.1 \ 
meanMomentum=$p sigmaP=10.0 meanT=0.0 sigmaT=0.0

##########################
### REFERENCE PARTICLE ###
##########################

# mu plus:
#reference referenceMomentum=$p particle=mu+ beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp beamZ=0.0 tuneMomentum=$p tuneZ=126275
#reference referenceMomentum=$p particle=mu+ beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp beamZ=0.0 tuneMomentum=$p tuneZ=4700
reference referenceMomentum=$p particle=mu+ beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp beamZ=0.0

# mu minus:
param tshift=-1/(325e6)*0.5
param zshift=$period_len*0.5
#reference referenceMomentum=$p particle=mu- beamX=$X beamY=$Y beamXp=$Xp beamYp=$Yp beamZ=$zshift

trace nTrace=0 format=ascii

#################
### SOLENOIDS ###
#################

coil coil innerRadius=420 outerRadius=600 length=300 nSheets=10 maxR=360 maxZ=6000 dR=15 dZ=15 tolerance=0.003 

solenoid SolPos coilName=coil current=-$sol_current color=0,1,1
solenoid SolNeg coilName=coil current=$sol_current color=0,1,0

###################
### RF CAVITIES ###
###################

pillbox RFC innerLength=$rf_len-1 frequency=0.325 maxGradient=$rf_grad \
    win1Thick=0 win1OuterRadius=0 collarThick=0 collarRadialThick=0 \
    winMat=Be irisRadius=300 win2Thick=0.12 wallThick=0.4 pipeThick=0.4 cavityMaterial=Vacuum kill=1

#################
### ABSORBERS ###
#################

trap wedge height=350 length=700 upperWidth=0.005 lowerWidth=59.5 material=LITHIUM_HYDRIDE color=0,0,1

#################
### PLACEMENT ###
#################

# 30 HFOFO periods + 1 at start + 1 at end for edge field effects

param num_periods=30

do i -1 $num_periods

    place SolPos z=500+$space*0+$period_len*$i current=-$sol_current rotation=X$pitch,Z240
    place SolNeg z=500+$space*1+$period_len*$i current=$sol_current rotation=X$pitch
    place SolPos z=500+$space*2+$period_len*$i current=-$sol_current rotation=X$pitch,Z120
    place SolNeg z=500+$space*3+$period_len*$i current=$sol_current rotation=X$pitch,Z240
    place SolPos z=500+$space*4+$period_len*$i current=-$sol_current rotation=X$pitch
    place SolNeg z=500+$space*5+$period_len*$i current=$sol_current rotation=X$pitch,Z120

    if $i<$num_periods
        if $i>-1
            place RFC z=500-$rf_len/2+$space*0+$period_len*$i
            place RFC z=500+$rf_len/2+$space*0+$period_len*$i

            place wedge x=-79.11 y=-155.4 rotation=Y90,Z-26.97 lowerWidth=26.834 z=500+$space/2+$space*0+$period_len*$i

            place RFC z=500-$rf_len/2+$space*1+$period_len*$i
            place RFC z=500+$rf_len/2+$space*1+$period_len*$i

            place wedge x=174.2 y=9.204 rotation=Y90,Z93.03 lowerWidth=26.820 z=500+$space/2+$space*1+$period_len*$i

            place RFC z=500-$rf_len/2+$space*2+$period_len*$i
            place RFC z=500+$rf_len/2+$space*2+$period_len*$i

            place wedge x=-95.05 y=146.2 rotation=Y90,Z213.0 lowerWidth=26.806 z=500+$space/2+$space*2+$period_len*$i

            place RFC z=500-$rf_len/2+$space*3+$period_len*$i
            place RFC z=500+$rf_len/2+$space*3+$period_len*$i

            place wedge x=-79.11 y=-155.4 rotation=Y90,Z333.0 lowerWidth=26.792 z=500+$space/2+$space*3+$period_len*$i

            place RFC z=500-$rf_len/2+$space*4+$period_len*$i
            place RFC z=500+$rf_len/2+$space*4+$period_len*$i

            place wedge x=174.2 y=9.204 rotation=Y90,Z453.0 lowerWidth=26.779 z=500+$space/2+$space*4+$period_len*$i

            place RFC z=500-$rf_len/2+$space*5+$period_len*$i
            place RFC z=500+$rf_len/2+$space*5+$period_len*$i

            place wedge x=-95.05 y=146.2 rotation=Y90,Z573.0 lowerWidth=26.766 z=500+$space/2+$space*5+$period_len*$i
        endif
    endif

enddo